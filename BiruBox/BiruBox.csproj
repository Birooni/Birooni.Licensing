<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release</Configurations>
    <AssemblyName>BiruBox</AssemblyName>
    <RootNamespace>BiruBox</RootNamespace>
    <Product>BiruBox</Product>
    <Description>Auto-Section Box add-in for Autodesk Revit</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\BiruBox.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Revit 2024: /p:RevitVersion=2024 and change TargetFramework to net48 -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Birooni.Client\Birooni.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BiruBox.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="install.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToRevitAddins" AfterTargets="Build">
    <PropertyGroup>
      <RevitAddins2025>$(AppData)\Autodesk\Revit\Addins\2025</RevitAddins2025>
      <RevitAddins2026>$(AppData)\Autodesk\Revit\Addins\2026</RevitAddins2026>
      <RevitAddins2027>$(AppData)\Autodesk\Revit\Addins\2027</RevitAddins2027>

      <BiruBoxFolder2025>$(RevitAddins2025)\Birooni Tools\BiruBox</BiruBoxFolder2025>
      <BiruBoxFolder2026>$(RevitAddins2026)\Birooni Tools\BiruBox</BiruBoxFolder2026>
      <BiruBoxFolder2027>$(RevitAddins2027)\Birooni Tools\BiruBox</BiruBoxFolder2027>
    </PropertyGroup>

    <ItemGroup>
      <RuntimeFiles Include="$(TargetDir)runtimes\**\*.*" />
    </ItemGroup>

    <!-- Revit 2025 -->
    <Copy SourceFiles="$(TargetDir)BiruBox.addin" DestinationFolder="$(RevitAddins2025)" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.dll" DestinationFolder="$(BiruBoxFolder2025)" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)Birooni.Client.dll" DestinationFolder="$(BiruBoxFolder2025)" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)System.Management.dll" DestinationFolder="$(BiruBoxFolder2025)" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.deps.json" DestinationFolder="$(BiruBoxFolder2025)" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFiles="@(RuntimeFiles->'$(BiruBoxFolder2025)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(RevitAddins2025)')" ContinueOnError="true" />

    <!-- Revit 2026 -->
    <Copy SourceFiles="$(TargetDir)BiruBox.addin" DestinationFolder="$(RevitAddins2026)" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.dll" DestinationFolder="$(BiruBoxFolder2026)" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)Birooni.Client.dll" DestinationFolder="$(BiruBoxFolder2026)" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)System.Management.dll" DestinationFolder="$(BiruBoxFolder2026)" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.deps.json" DestinationFolder="$(BiruBoxFolder2026)" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFiles="@(RuntimeFiles->'$(BiruBoxFolder2026)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(RevitAddins2026)')" ContinueOnError="true" />

    <!-- Revit 2027 -->
    <Copy SourceFiles="$(TargetDir)BiruBox.addin" DestinationFolder="$(RevitAddins2027)" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.dll" DestinationFolder="$(BiruBoxFolder2027)" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)Birooni.Client.dll" DestinationFolder="$(BiruBoxFolder2027)" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)System.Management.dll" DestinationFolder="$(BiruBoxFolder2027)" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)BiruBox.deps.json" DestinationFolder="$(BiruBoxFolder2027)" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFiles="@(RuntimeFiles->'$(BiruBoxFolder2027)\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(RevitAddins2027)')" ContinueOnError="true" />

    <Message Text="[BiruBox] Deployed to $(BiruBoxFolder2025)" Importance="high" Condition="Exists('$(RevitAddins2025)')" />
  </Target>
</Project>

<Window x:Class="FamilyLoader.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Family Loader Settings" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FamilyLoader;component/WPF/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Middle Panel: Nested Tabs and Panels -->
        <Grid Grid.Row="0">
            <!-- Top Level TabControl (Ribbon Tabs) -->
            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <!-- We could add drag-drop for tabs here later, keeping simple for now -->
                        <Setter Property="Header" Value="{Binding Name}" />
                    </Style>
                </TabControl.ItemContainerStyle>
                
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tab Action Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ribbon Tab Name:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                        <Button Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="-" Width="30" Height="24" Margin="5,0,0,0" Style="{DynamicResource DangerButton}" ToolTip="Remove This Tab" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding AddPanelCommand}" Content="+ Add Panel" Style="{DynamicResource PrimaryButton}" Padding="10,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Panels TabControl (Second Level) -->
                            <TabControl x:Name="PanelTabControl" Grid.Row="1" ItemsSource="{Binding Panels}">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="AllowDrop" Value="True"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove"/>
                                        <EventSetter Event="Drop" Handler="TabItem_Drop"/>
                                    </Style>
                                </TabControl.ItemContainerStyle>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Panel Action Bar -->
                                            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="6,6,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Panel Name:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="150" />
                                                        <Button Command="{Binding DataContext.SelectedTab.RemovePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="-" Width="30" Height="24" Margin="5,0,0,0" Style="{DynamicResource DangerButton}" ToolTip="Remove This Panel"/>
                                                    </StackPanel>

                                                    <!-- DataContext here is PanelViewModel -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Command="{Binding AddMultipleFamiliesCommand}" Content="+ Add Multiple Families" Style="{DynamicResource PrimaryButton}" Padding="10,6" ToolTip="Select multiple RFA files at once" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Families DataGrid -->
                                            <DataGrid Grid.Row="1" Margin="0" MinHeight="100" ItemsSource="{Binding Families}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="AllowDrop" Value="True"/>
                                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                                                        <EventSetter Event="PreviewMouseMove" Handler="DataGridRow_PreviewMouseMove"/>
                                                        <EventSetter Event="Drop" Handler="DataGridRow_Drop"/>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <!-- RFA path with browse button -->
                                                    <DataGridTemplateColumn Header="Revit Family File (.rfa)" Width="1*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding RfaPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,0,5,0" Height="28" VerticalContentAlignment="Center"/>
                                                                    <Button Grid.Column="1" Command="{Binding BrowseRfaCommand}" Content="Browse..." Style="{DynamicResource IconBrowseButton}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="5,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Height" Value="28"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <DataGridCheckBoxColumn Header="Icon Only" Binding="{Binding IsIconOnly, UpdateSourceTrigger=PropertyChanged}" Width="0.7*">
                                                        <DataGridCheckBoxColumn.HeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.HeaderStyle>
                                                        <DataGridCheckBoxColumn.ElementStyle>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.ElementStyle>
                                                        <DataGridCheckBoxColumn.EditingElementStyle>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.EditingElementStyle>
                                                    </DataGridCheckBoxColumn>

                                                    <DataGridCheckBoxColumn Header="Types as Push Button" Binding="{Binding IsTypesAsPushButtons, UpdateSourceTrigger=PropertyChanged}" Width="1.2*">
                                                        <DataGridCheckBoxColumn.HeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.HeaderStyle>
                                                        <DataGridCheckBoxColumn.ElementStyle>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.ElementStyle>
                                                        <DataGridCheckBoxColumn.EditingElementStyle>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.EditingElementStyle>
                                                    </DataGridCheckBoxColumn>

                                                    <DataGridTemplateColumn Header="Rows" Width="0.6*">
                                                        <DataGridTemplateColumn.HeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="ToolTip" Value="How many buttons to stack in one ribbon column. 1 = large button, 2 or 3 = stacked rows. Works with or without Types as Push Button and Icon Only."/>
                                                            </Style>
                                                        </DataGridTemplateColumn.HeaderStyle>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding StackRowOptions}"
                                                                          SelectedItem="{Binding StackRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Height="28" Margin="2" Width="52"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalContentAlignment="Center"
                                                                          ToolTip="1 = large button. 2 or 3 = stacked rows in one column."/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Types Icons" Width="1*">
                                                        <DataGridTemplateColumn.HeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTemplateColumn.HeaderStyle>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding OpenTypesCommand}" Content="Config..." Style="{DynamicResource SecondaryButton}" Margin="5,2" HorizontalAlignment="Center" Width="80"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>



                                                    <!-- Icon Path or Preview -->
                                                    <DataGridTemplateColumn Header="Custom Icon Path" Width="1*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,0,5,0" Height="28" VerticalContentAlignment="Center"/>
                                                                    <Button Grid.Column="1" Command="{Binding BrowseIconCommand}" Content="Browse..." Style="{DynamicResource IconBrowseButton}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Remove Row -->
                                                    <DataGridTemplateColumn Header="" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DeleteCommand}" Content="Remove" Padding="10,5" Margin="5,2" Style="{DynamicResource DangerButton}" ToolTip="Remove Family"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            
            <Button Command="{Binding AddTabCommand}" Content="+ Add Tab" Style="{DynamicResource PrimaryButton}" Padding="15,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" />
        </Grid>

        <!-- Bottom Panel: Action Buttons -->
        <!-- DataContext here is SettingsViewModel -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding ImportCommand}" Content="Import" Style="{StaticResource SecondaryButton}" Width="120" Height="40" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Command="{Binding ExportCommand}" Content="Export" Style="{StaticResource SecondaryButton}" Width="120" Height="40" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Content="Save" Style="{StaticResource PrimaryButton}" Width="100" Height="40" Margin="0,0,10,0" />
                <Button Command="{Binding CloseCommand}" Content="Close" Style="{StaticResource SecondaryButton}" Width="100" Height="40" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="FamilyLoader.UI.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Loader Licensing"
        Height="540" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Device ID -->
            <RowDefinition Height="*"/>    <!-- Tabs / Content -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Family Loader for Revit" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Dynamic Ribbon &amp; RFA Catalog Licensing" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadgeBorder" Background="#1E293B" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="Checking..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Device Fingerprint -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Hardware ID:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
                <TextBox Grid.Column="1" x:Name="TxtHardwareId" IsReadOnly="True" Background="#F8FAFC" BorderThickness="0" FontFamily="Consolas" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="BtnCopyHwId" Content="Copy" Padding="10,4" Margin="8,0,0,0" Background="#E2E8F0" Foreground="#1E293B" Click="BtnCopyHwId_Click"/>
            </Grid>
        </Border>

        <!-- 3. Tabs: Activate / Free Trial / License Info -->
        <TabControl Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <!-- TAB 1: Activate License -->
            <TabItem Header="Activate License">
                <StackPanel Margin="16">
                    <TextBlock Text="Enter your Family Loader License Key:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLicenseKey" Margin="0,0,0,14" FontFamily="Consolas" Text="BIROONI-"/>
                    <Button x:Name="BtnActivate" Content="Activate License" Height="36" Click="BtnActivate_Click"/>
                    <TextBlock Text="Requires an internet connection once during initial activation." FontSize="11" Foreground="#64748B" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: 14-Day Free Trial -->
            <TabItem Header="Start Free Trial">
                <StackPanel Margin="16">
                    <TextBlock Text="Start a 14-day free trial on this machine. No credit card required." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Your Name:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTrialName" Margin="0,0,0,10"/>

                    <TextBlock Text="Your Work Email:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTrialEmail" Margin="0,0,0,14"/>

                    <Button x:Name="BtnClaimTrial" Content="Claim 14-Day Free Trial" Height="36" Background="#16A34A" Click="BtnClaimTrial_Click"/>
                </StackPanel>
            </TabItem>

            <!-- TAB 3: License Details & Transfer -->
            <TabItem Header="License Details">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type:" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDetailType" Text="—" Foreground="#1E293B"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="License Key:" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDetailCustomer" Text="—" FontFamily="Consolas" Foreground="#1E293B"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Expires:" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDetailExpiry" Text="—" Foreground="#1E293B"/>
                    </Grid>

                    <Separator Margin="0,0,0,16"/>

                    <Button x:Name="BtnDeactivate" Content="Deactivate on this PC (Transfer Seat)" Background="#DC2626" Height="34" Click="BtnDeactivate_Click"/>
                    <TextBlock Text="Deactivating frees up this seat so you can activate on another PC." FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 4. Footer Message & Close Button -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TxtStatusMessage" Text="Ready" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Close" Background="#64748B" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>

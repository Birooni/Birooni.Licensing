<Window x:Class="Biruscan.UI.Views.FloorPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floor Plan Tool — Biruscan"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Create Floor Plan from Point Cloud"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Level Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="txtLevelName" Text="Level 1 - Cloud"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Elevation (ft):" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="txtElevation" Text="0.00"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Slice Thickness (ft):" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="txtThickness" Text="5.00"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="The Floor Plan Tool creates a new level and plan view at the specified elevation, with a thin slice of the point cloud visible."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnCreate" Content="Create Floor Plan" Width="120" Height="30" Margin="0,0,8,0" Click="BtnCreate_Click"/>
            <Button Name="btnCancel" Content="Cancel" Width="80" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

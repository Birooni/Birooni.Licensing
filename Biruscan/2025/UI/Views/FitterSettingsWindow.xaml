<Window x:Class="Biruscan.UI.Views.FitterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitter Settings" Height="580" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" BorderThickness="1" BorderBrush="#333333">

    <Border CornerRadius="8" Background="#1E1E1E" BorderThickness="1" BorderBrush="#3E3E42">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="FITTER SETTINGS" FontSize="18" FontWeight="Bold" Foreground="#00BCD4"/>
                    <TextBlock Text="Configure default element types for Fitter tools" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- Body -->
            <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#3E3E42" Margin="0,10,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="1,1,1,0"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#00BCD4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: PIPING -->
                <TabItem Header="Piping">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Piping Types" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Pipe Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbPipeType" Height="28" Margin="0,0,0,10"/>

                                    <TextBlock Text="Piping System Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbPipingSystemType" Height="28" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: DUCT -->
                <TabItem Header="Duct">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Duct Types" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Rectangular Duct Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbDuctType" Height="28" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Round Duct Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbRoundDuctType" Height="28" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Duct System Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbDuctSystemType" Height="28" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: CABLE TRAY -->
                <TabItem Header="Cable Tray">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Cable Tray Types" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Cable Tray Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbCableTrayType" Height="28" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Fit Accuracy" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkSnapNominal" Content="Snap measured sizes to nearest catalog size"
                                  Foreground="#CCCCCC" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Only snap if within (%)" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSnapPercent" Grid.Column="1" Height="24" TextAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ortho-snap run axis if within (deg)" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtOrthoDeg" Grid.Column="1" Height="24" TextAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            <Grid>
                <Button x:Name="btnReset" Content="Reset Defaults" Width="120" Height="34" HorizontalAlignment="Left"
                        Background="#333337" Foreground="#CCCCCC" BorderBrush="#555555" Cursor="Hand" Click="BtnReset_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,10,0"
                            Background="#333337" Foreground="White" BorderBrush="#555555" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button x:Name="btnSave" Content="Save Settings" Width="120" Height="34"
                            Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

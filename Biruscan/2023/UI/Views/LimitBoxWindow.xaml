<Window x:Class="Biruscan.UI.Views.LimitBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limit Box — Biruscan"
        Width="400" Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Define Limit Box"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Method" Margin="0,0,0,10" Padding="8">
            <StackPanel>
                <RadioButton Name="rbPickPoints" Content="Pick 2 corner points on the point cloud" IsChecked="True" Margin="0,0,0,5"/>
                <RadioButton Name="rbManualEntry" Content="Enter bounding box coordinates manually" Margin="0,0,0,5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Manual Coordinates (feet)" Margin="0,0,0,10" Padding="8" Name="grpManual">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Min X:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="txtMinX" Text="0" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Max X:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="0" Grid.Column="3" Name="txtMaxX" Text="100" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Y:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="txtMinY" Text="0" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Max Y:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="3" Name="txtMaxY" Text="100" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Z:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="txtMinZ" Text="0" Margin="0,0,10,5"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Max Z:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="3" Name="txtMaxZ" Text="20" Margin="0,0,0,5"/>
            </Grid>
        </GroupBox>

        <CheckBox Grid.Row="3" Name="chkApplySectionBox" Content="Apply as Section Box in 3D view" IsChecked="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnApply" Content="Apply" Width="80" Height="28" Margin="0,0,8,0" Click="BtnApply_Click"/>
            <Button Name="btnCancel" Content="Cancel" Width="80" Height="28" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

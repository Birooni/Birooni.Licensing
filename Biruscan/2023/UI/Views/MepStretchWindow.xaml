<Window x:Class="Biruscan.UI.Views.MepStretchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stretch" Height="380" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#2D2D30">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#3F3F46" BorderBrush="#555" BorderThickness="1,1,1,0"
                                Margin="0,0,4,0" Padding="{TemplateBinding Padding}" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="ModeTabs" Grid.Row="0" Grid.Column="0" Margin="0,0,12,8"
                    Background="#2D2D30" BorderThickness="0"
                    SelectionChanged="ModeTabs_SelectionChanged">
            <TabItem Header="Along Axis">
                <Grid Margin="8,12,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="End 1:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="End1Slider" Grid.Column="0"
                                Minimum="-5" Maximum="5" Value="0"
                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                SmallChange="0.01" LargeChange="0.25"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                ValueChanged="AxisSlider_ValueChanged"/>
                        <TextBox x:Name="End1TextBox" Grid.Column="1"
                                 Text="{Binding ElementName=End1Slider, Path=Value, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,80,12">
                        <TextBlock Text="−" HorizontalAlignment="Left" Foreground="#A0A0A0"/>
                        <TextBlock Text="0" HorizontalAlignment="Center" Foreground="#A0A0A0"/>
                        <TextBlock Text="+" HorizontalAlignment="Right" Foreground="#A0A0A0"/>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="End 2:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="End2Slider" Grid.Column="0"
                                Minimum="-5" Maximum="5" Value="0"
                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                SmallChange="0.01" LargeChange="0.25"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                ValueChanged="AxisSlider_ValueChanged"/>
                        <TextBox x:Name="End2TextBox" Grid.Column="1"
                                 Text="{Binding ElementName=End2Slider, Path=Value, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,4,80,0">
                        <TextBlock Text="−" HorizontalAlignment="Left" Foreground="#A0A0A0"/>
                        <TextBlock Text="0" HorizontalAlignment="Center" Foreground="#A0A0A0"/>
                        <TextBlock Text="+" HorizontalAlignment="Right" Foreground="#A0A0A0"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="AlongPlaneTab" Header="Along Plane">
                <Grid Margin="8,12,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Offset:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PlaneSlider" Grid.Column="0"
                                Minimum="-5" Maximum="5" Value="0"
                                TickFrequency="0.01" IsSnapToTickEnabled="True"
                                SmallChange="0.01" LargeChange="0.25"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                ValueChanged="PlaneSlider_ValueChanged"/>
                        <TextBox x:Name="PlaneTextBox" Grid.Column="1"
                                 Text="{Binding ElementName=PlaneSlider, Path=Value, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,80,0">
                        <TextBlock Text="−" HorizontalAlignment="Left" Foreground="#A0A0A0"/>
                        <TextBlock Text="0" HorizontalAlignment="Center" Foreground="#A0A0A0"/>
                        <TextBlock Text="+" HorizontalAlignment="Right" Foreground="#A0A0A0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="0" Grid.Column="1" Background="#252526" Padding="10" CornerRadius="4" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Maximum increment" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="MaxTextBox" Height="28"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"
                         LostFocus="MaxTextBox_LostFocus" KeyDown="MaxTextBox_KeyDown"/>
                <TextBlock x:Name="UnitLabel" Text="m" FontSize="12" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="Default 5 m, shown in the project length unit. End 1, End 2, and Along Plane use −max to +max." FontSize="11" Foreground="#808080" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,8"
                   Text="Along Axis: + stretches each end, − shortens. Connected fittings and pipes move with it."
                   FontStyle="Italic" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="OK" Click="BtnOK_Click" Background="#007ACC" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>

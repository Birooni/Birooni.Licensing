<Window x:Class="Biruscan.UI.Views.MepSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Routing &amp; Pull Settings" Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" BorderThickness="1" BorderBrush="#333333">

    <Border CornerRadius="8" Background="#1E1E1E" BorderThickness="1" BorderBrush="#3E3E42">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="MEP SETTINGS" FontSize="18" FontWeight="Bold" Foreground="#00BCD4"/>
                    <TextBlock Text="Configure Pull (Bloom) stub dimensions, routing preferences, and elbow lengths" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- Tabbed Settings Body -->
            <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#3E3E42">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="1,1,1,0"/>
                        <Setter Property="BorderBrush" Value="#3E3E42"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#00BCD4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: PULL (BLOOM) SETTINGS -->
                <TabItem Header="Pull Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <!-- Stub Extension Lengths -->
                            <TextBlock Text="Default Stub Extension Lengths" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Pipe Length -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pipe Stub Length (ft):" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPipeLength" Height="28" Background="#333337" Foreground="White" BorderBrush="#555555" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,4"/>

                                    <!-- Duct Length -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Duct Stub Length (ft):" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDuctLength" Height="28" Background="#333337" Foreground="White" BorderBrush="#555555" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,4"/>

                                    <!-- Conduit Length -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Conduit Stub Length (ft):" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtConduitLength" Height="28" Background="#333337" Foreground="White" BorderBrush="#555555" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,4"/>
                                </Grid>
                            </Border>

                            <!-- Default Types Override -->
                            <TextBlock Text="Default Family &amp; System Types" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Preferred Pipe Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbPipeType" Height="28" Margin="0,0,0,10"/>

                                    <TextBlock Text="Preferred Rectangular Duct Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbRectDuctType" Height="28" Margin="0,0,0,10"/>

                                    <TextBlock Text="Preferred Round Duct Type" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbRoundDuctType" Height="28" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Options -->
                            <CheckBox x:Name="chkAutoConnect" Content="Auto-connect generated stubs to equipment connectors" IsChecked="True" Foreground="White" Margin="4,0,0,6"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: ELBOW ROUTING SETTINGS -->
                <TabItem Header="Elbow Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="5">
                            <TextBlock Text="Directional Elbow Routing" FontWeight="Bold" Foreground="#00BCD4" Margin="0,0,0,8"/>
                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default Branch Extension Length (ft):" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                    <TextBox Grid.Column="1" x:Name="txtElbowLength" Height="28" Background="#333337" Foreground="White" BorderBrush="#555555" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Info Box -->
                            <Border Background="#1A3344" BorderBrush="#00BCD4" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Supported Elbow Directions:" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,6"/>
                                    <TextBlock Text="• 90° Standard: Elbow Up (+Z), Down (-Z), Left, and Right" Foreground="#DDDDDD" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="• 45° Planar &amp; Elevation: Elbow Up 45, Down 45, Left 45, Right 45" Foreground="#DDDDDD" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="• Automatically resolves nearest open connector and trims with standard Revit routing preferences." Foreground="#AAAAAA" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Button x:Name="btnReset" Content="Reset Defaults" Width="120" Height="34" HorizontalAlignment="Left"
                        Background="#333337" Foreground="#CCCCCC" BorderBrush="#555555" Cursor="Hand" Click="BtnReset_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,10,0"
                            Background="#333337" Foreground="White" BorderBrush="#555555" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button x:Name="btnSave" Content="Save Settings" Width="120" Height="34"
                            Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

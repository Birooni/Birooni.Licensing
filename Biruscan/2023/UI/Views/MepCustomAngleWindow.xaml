<Window x:Class="Biruscan.UI.Views.MepCustomAngleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Angle Elbow" Height="340" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#2D2D30">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Bend Angle (Degrees):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="BendAngleSlider" Grid.Column="0" 
                    Minimum="2.5" Maximum="95" Value="30" 
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="5"
                    VerticalAlignment="Center" Margin="0,0,15,0"
                    ValueChanged="Slider_ValueChanged" />
            <TextBox x:Name="BendAngleTextBox" Grid.Column="1" 
                     Text="{Binding ElementName=BendAngleSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                     Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Axial Rotation (Degrees):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="AxialAngleSlider" Grid.Column="0" 
                    Minimum="0" Maximum="360" Value="0" 
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="5"
                    VerticalAlignment="Center" Margin="0,0,15,0"
                    ValueChanged="Slider_ValueChanged" />
            <TextBox x:Name="AxialAngleTextBox" Grid.Column="1" 
                     Text="{Binding ElementName=AxialAngleSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                     Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="Step (Degrees):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="StepSlider" Grid.Column="0"
                    Minimum="0.5" Maximum="15" Value="1"
                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                    SmallChange="0.5" LargeChange="1"
                    VerticalAlignment="Center" Margin="0,0,15,0"
                    ValueChanged="StepSlider_ValueChanged" />
            <TextBox x:Name="StepTextBox" Grid.Column="1"
                     Text="{Binding ElementName=StepSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46"/>
        </Grid>

        <TextBlock Grid.Row="6" Text="Move the sliders to see a live preview in Revit." FontStyle="Italic" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="OK" Click="BtnOK_Click" Background="#007ACC" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
